{
  "name": "kalorien",
  "version": "1.0.0",
  "private": true,
  "description": "Kalorienzähler mit Spracheingabe (PWA)",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "build:vendor": "echo 'export { default } from \"@anthropic-ai/sdk\";' > .sdk-entry.js && esbuild .sdk-entry.js --bundle --format=esm --platform=browser --minify --legal-comments=eof --outfile=js/vendor/anthropic-sdk.js && rm .sdk-entry.js"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "esbuild": "0.24.0"
  }
}
